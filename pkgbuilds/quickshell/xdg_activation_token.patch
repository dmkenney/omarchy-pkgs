diff --git a/src/wayland/xdg_activation.cpp b/src/wayland/xdg_activation.cpp
new file mode 100644
index 0000000..36728e5
--- /dev/null
+++ b/src/wayland/xdg_activation.cpp
@@ -0,0 +1,67 @@
+#include <private/qwaylanddisplay_p.h>
+#include <private/qwaylandinputdevice_p.h>
+#include <private/qwaylandintegration_p.h>
+#include <private/qwaylandwindow_p.h>
+#include <qstring.h>
+#include <qtclasshelpermacros.h>
+#include <qwayland-xdg-activation-v1.h>
+#include <qwaylandclientextension.h>
+#include <wayland-xdg-activation-v1-client-protocol.h>
+
+#include "../core/activationtoken.hpp"
+
+namespace {
+
+class XdgActivationToken: public QtWayland::xdg_activation_token_v1 {
+public:
+	explicit XdgActivationToken(::xdg_activation_token_v1* token)
+	    : QtWayland::xdg_activation_token_v1(token) {}
+	~XdgActivationToken() override { this->destroy(); }
+	Q_DISABLE_COPY_MOVE(XdgActivationToken);
+
+	QString token;
+
+protected:
+	void xdg_activation_token_v1_done(const QString& token) override { this->token = token; }
+};
+
+class XdgActivation
+    : public QWaylandClientExtensionTemplate<XdgActivation>
+    , public QtWayland::xdg_activation_v1 {
+public:
+	explicit XdgActivation(): QWaylandClientExtensionTemplate(1) { this->initialize(); }
+
+	static XdgActivation* instance() {
+		static auto* instance = new XdgActivation(); // NOLINT
+		return instance->isInitialized() ? instance : nullptr;
+	}
+};
+
+QString requestToken() {
+	auto* activation = XdgActivation::instance();
+	auto* integration = QtWaylandClient::QWaylandIntegration::instance();
+	if (!activation || !integration) return {};
+
+	auto* display = integration->display();
+	auto token = XdgActivationToken(activation->get_activation_token());
+
+	if (auto* device = display->lastInputDevice()) {
+		token.set_serial(display->lastInputSerial(), device->wl_seat());
+	}
+
+	if (auto* window = display->lastInputWindow()) {
+		token.set_surface(window->wlSurface());
+	}
+
+	token.commit();
+	// The compositor answers with the done event; wait for it so callers get
+	// the token synchronously.
+	display->forceRoundTrip();
+	return token.token;
+}
+
+} // namespace
+
+void installXdgActivationTokenProvider() { // NOLINT(misc-use-internal-linkage)
+	qs::core::activationTokenProvider = &requestToken;
+}
