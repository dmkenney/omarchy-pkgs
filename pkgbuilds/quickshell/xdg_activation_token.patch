index 0000000..2418f60
--- /dev/null
+++ b/src/core/activationtoken.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <qstring.h>
+
+namespace qs::core {
+
+// Requests an xdg-activation token tied to the most recent user input, so a
+// client acting on that input (e.g. a clicked notification) can raise its own
+// window. Set by the platform integration; returns an empty string when the
+// platform has no activation protocol.
+// NOLINTNEXTLINE(cppcoreguidelines-avoid-non-const-global-variables)
+inline QString (*activationTokenProvider)() = nullptr;
+
+inline QString requestActivationToken() {
+	return activationTokenProvider ? activationTokenProvider() : QString();
+}
+
+} // namespace qs::core
